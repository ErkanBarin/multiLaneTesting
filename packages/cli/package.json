{
  "name": "@erkanbarin/cli",
  "version": "0.2.6",
  "description": "The `mlt` command line for multilanetesting: verify deterministic gates and scaffold consumer projects.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mlt": "./bin/mlt.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "files": [
    "bin/mlt.mjs",
    "index.mjs",
    "index.d.ts",
    "src/**/*.mjs",
    "README.md"
  ],
  "dependencies": {
    "@erkanbarin/core": "0.1.1"
  },
  "devDependencies": {
    "@erkanbarin/authoring-web": "0.1.1",
    "@erkanbarin/authoring-http": "0.1.2",
    "@erkanbarin/authoring-stomp": "0.1.2",
    "@erkanbarin/authoring-screen": "0.2.2",
    "@erkanbarin/authoring-snmp": "0.1.2",
    "@erkanbarin/authoring-trap": "0.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErkanBarin/multiLaneTesting.git",
    "directory": "packages/cli"
  }
}
