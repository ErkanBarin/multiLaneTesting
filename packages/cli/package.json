{
  "name": "@multilane/cli",
  "version": "0.2.6",
  "description": "The `mlt` command line for multilanetesting: verify deterministic gates and scaffold consumer projects.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "mlt": "./bin/mlt.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "files": [
    "bin/mlt.mjs",
    "index.mjs",
    "index.d.ts",
    "src/**/*.mjs",
    "README.md"
  ],
  "dependencies": {
    "@multilane/core": "0.1.1"
  },
  "devDependencies": {
    "@multilane/authoring-web": "0.1.1",
    "@multilane/authoring-http": "0.1.2",
    "@multilane/authoring-stomp": "0.1.2",
    "@multilane/authoring-screen": "0.2.2",
    "@multilane/authoring-snmp": "0.1.2",
    "@multilane/authoring-trap": "0.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
