{
  "name": "@erkanbarin/authoring-http",
  "version": "0.1.2",
  "description": "HTTP-lane authoring assets (skills, agents, prompts) for the multilanetesting engine. Development-time content only — never a runtime dependency of @erkanbarin/http.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./lane.manifest.json": "./lane.manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "lane.manifest.json",
    "assets/**",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErkanBarin/multiLaneTesting.git",
    "directory": "packages/authoring-http"
  }
}
