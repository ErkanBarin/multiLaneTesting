{
  "name": "@erkanbarin/authoring-screen",
  "version": "0.2.2",
  "description": "Screen-lane authoring assets (skills, agents, the screen-driver MCP server) for the multilanetesting engine. Development-time content only — never a runtime dependency of @erkanbarin/screen.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "multilane-screen-mcp": "./mcp/server.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./lane.manifest.json": "./lane.manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "lane.manifest.json",
    "assets/**",
    "mcp/server.mjs",
    "README.md"
  ],
  "peerDependencies": {
    "@erkanbarin/screen": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@erkanbarin/screen": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErkanBarin/multiLaneTesting.git",
    "directory": "packages/authoring-screen"
  }
}
