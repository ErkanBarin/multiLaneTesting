{
  "servers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.70",
        "--browser",
        "chromium"
      ]
    },
    "screen-driver": {
      "command": "npx",
      "args": [
        "tsx",
        "drivers/mcp/server.ts"
      ],
      "env": {
        "SCREEN_DRIVER_MODE": "authoring"
      }
    }
  }
}
