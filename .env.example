# multilanetesting — environment template. Copy to .env (gitignored) and fill in real values.
# NEVER commit real hosts, partitions, or secrets. Committed files reference these names only.
# Build only the sections that apply to the target system under test.

# --- Web / DOM lane ---
MULTILANE_WEB_BASE_URL=        # base URL of the web UI (if the target exposes a DOM)

# --- API contract lane (passive, opt-in) ---
MULTILANE_API_CONTRACT=0       # set to 1 to enable
MULTILANE_TARGET_HOST=         # REST API host
MULTILANE_APPROVED_HOSTS=      # comma-separated allowlist

# --- WS contract lane (opt-in) ---
MULTILANE_WS_CONTRACT=0        # set to 1 to enable passive SUBSCRIBE
MULTILANE_WS_INJECT=0          # set to 1 (WITH the above) to allow supervised active SEND
MULTILANE_WS_URL=              # STOMP-over-WebSocket endpoint

# --- Screen-driver lane (VNC/RDP / C++ HMI / COTS) ---
SCREEN_TARGET_HOST=            # VNC/RDP host of the screen target (test partition machine)
SCREEN_RPS_PARTITION=TEST_A       # test partition: TEST_A | TEST_B | TEST_C  (NEVER PROD)
SCREEN_DISPLAY=:99             # Xvfb display for headless runs

# --- Authoring-only (vision discovery / supervised heal). NEVER used at runtime. ---
# Provide a key only on an isolated authoring workstation, never in CI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
