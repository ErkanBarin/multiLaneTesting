# --- Secrets / local-only operational truth ---
.env
.env.*
!.env.example
.npmrc
!.npmrc.sample
CLAUDE.md
.claude/settings.local.json

# --- Node ---
node_modules/
npm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/

# --- Local file: tarballs (rebuild: npm pack in each package) ---
tarballs/

# --- Test output / evidence ---
results/
artifacts/
test-results/
playwright-report/
*.junit.xml

# --- Golden-image working/diff dirs (keep baselines, ignore diffs) ---
**/__diff__/
**/__received__/

# --- RAG cache (commit graph.json/report, skip heavy cache) ---
graphify-out/cache/

# --- Playwright CLI session junk ---
.playwright-cli/

# --- OS / editor ---
.DS_Store
Thumbs.db
**/.nfs*

# --- Local reference docs not for version control ---
docs/reference/*.pdf

# --- Workspace files embed local paths ---
*.code-workspace
